# CCNR-Data 运行时配置示例。复制为 .env 或直接 export。
# 所有变量都有 `CCNR_DATA_` 前缀；命令行参数优先于环境变量。

# ---------- 数据库 / 迁移 ----------
# SQLAlchemy URL；留空则由 DB_FILE 推导为 sqlite+pysqlite:///<绝对路径>
CCNR_DATA_DATABASE_URL=
CCNR_DATA_DB_FILE=var/ccnr-data.db

# ---------- gRPC ----------
CCNR_DATA_BIND=127.0.0.1:8081
CCNR_DATA_MAX_WORKERS=16
CCNR_DATA_WATCH_POLL_MS=500
CCNR_DATA_LOG_LEVEL=INFO

# ---------- HTTP 边缘（健康 / 指标 / 身份回调） ----------
CCNR_DATA_HTTP_BIND=127.0.0.1:8082

# gRPC 客户端 token；JSON 对象，空表示不鉴权。
# 例：CCNR_DATA_CLIENT_TOKENS={"proxy":"change-me","bot":"change-me-too"}
CCNR_DATA_CLIENT_TOKENS=

# ---------- Casdoor（只走 REST，不读库） ----------
CCNR_DATA_CASDOOR_ENDPOINT=
CCNR_DATA_CASDOOR_CLIENT_ID=
CCNR_DATA_CASDOOR_CLIENT_SECRET=
CCNR_DATA_CASDOOR_ORGANIZATION=ccnr
CCNR_DATA_CASDOOR_TIMEOUT_MS=2000
CCNR_DATA_CASDOOR_CACHE_TTL_S=60
# Casdoor 不可达且没有缓存时：deny / allow
CCNR_DATA_AUTH_FAIL_MODE=deny
# Casdoor 角色 → 内部控制角色；JSON。留空表示「邮箱已验证即放行」
CCNR_DATA_ROLE_MAP=

# ---------- 准入 / 统计 ----------
CCNR_DATA_HEARTBEAT_TTL_S=180
CCNR_DATA_PROXY_EVENT_RETENTION_DAYS=30
CCNR_DATA_SESSION_RETENTION_DAYS=365
CCNR_DATA_AUTO_LINK_BY_USERNAME=false

# ---------- 既有数据面轮换 ----------
CCNR_DATA_EVENT_RETENTION_DAYS=30
CCNR_DATA_CHANGE_RETENTION_DAYS=7
CCNR_DATA_AUDIT_RETENTION_DAYS=365
CCNR_DATA_IDEMPOTENCY_RETENTION_DAYS=30
